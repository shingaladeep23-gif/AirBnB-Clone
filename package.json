{
  "name": "airbnb-listing-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel-perfect desktop clone of an Airbnb listing page — PlayPower Labs take-home.",
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run check:tokens"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
