{
  "name": "airbnb-listing-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel-perfect desktop clone of an Airbnb listing page — PlayPower Labs take-home.",
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:photos": "node scripts/check-photo-order.mjs",
    "check:copy": "node scripts/check-copy-verbatim.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "check:dates": "tsx scripts/check-dates.ts",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run check:tokens && npm run check:photos && npm run check:copy && npm run check:dates",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "^13.0.3",
    "next": "^16.2.12",
    "prisma": "^7.9.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
